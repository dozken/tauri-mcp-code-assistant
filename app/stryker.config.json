{
  "$schema": "../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.config.ts"
  },
  "coverageAnalysis": "perTest",
  "reporters": ["clear-text", "progress", "html"],
  "htmlReporter": {
    "fileName": "reports/mutation/index.html"
  },
  "mutate": [
    "src/**/*.{ts,tsx}",
    "!src/**/*.test.{ts,tsx}",
    "!src/main.tsx",
    "!src/types.ts",
    "!src/test/**",
    "!src/api/config.ts"
  ],
  "ignorePatterns": ["dist", "coverage", "reports", "e2e", "src-tauri"],
  "timeoutMS": 60000,
  "concurrency": 2,
  "thresholds": {
    "high": 80,
    "low": 68,
    "break": 60
  }
}
