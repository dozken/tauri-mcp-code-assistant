{
  "name": "@ai-code-companion/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "NestJS backend: indexing, retrieval, LangChain agent loop and MCP tool server.",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./dist/main.js",
    "./mcp-server": "./dist/mcp-server.js"
  },
  "scripts": {
    "dev": "nest start --watch --builder swc",
    "dev:tsc": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "mcp": "node dist/mcp-server.js",
    "mcp:dev": "node --experimental-strip-types --no-warnings src/mcp-server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "mutation": "stryker run",
    "package": "npm run build && node scripts/package.mjs",
    "package:if-missing": "npm run build && node scripts/package.mjs --if-missing"
  },
  "dependencies": {
    "@ai-code-companion/contracts": "*",
    "@langchain/core": "^1.2.9",
    "@langchain/langgraph": "^1.4.13",
    "@langchain/mcp-adapters": "^1.1.4",
    "@langchain/ollama": "^1.3.0",
    "@langchain/openai": "^1.5.11",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/platform-socket.io": "^12.0.1",
    "@nestjs/websockets": "^12.0.1",
    "chromadb": "^3.5.0",
    "ignore": "^7.0.5",
    "nestjs-pino": "^5.0.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^12.0.1",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.0",
    "@types/node": "^22.10.10",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2",
    "typescript": "5.7.3",
    "unplugin-swc": "^1.5.11",
    "vitest": "^4.1.11"
  },
  "optionalDependencies": {
    "sqlite3": "^6.0.1"
  }
}
