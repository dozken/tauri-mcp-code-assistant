# Copy to backend/.env or export these before `npm run dev:backend`.
# Every value below is optional — the app runs fully offline with the defaults.

# --- HTTP ---------------------------------------------------------------
# Loopback by default: the backend reads local files and is not meant to be shared.
HOST=127.0.0.1
PORT=3001
CORS_ORIGINS=http://localhost:1420,http://127.0.0.1:1420,tauri://localhost,http://tauri.localhost

# --- Access control -----------------------------------------------------
# The backend binds to loopback, but "loopback" is not a security boundary: any
# page the user has open can POST to 127.0.0.1, and any local process can too.
# A browser cannot forge `Origin`, so the desktop app is let in on CORS_ORIGINS
# alone. Anything without an `Origin` — curl, a script — must send the token.
# A fresh token is generated per run and written to COMPANION_TOKEN_FILE (0600).
# AUTH_ENABLED=true                            # false disables the check entirely
# COMPANION_TOKEN=                             # pin a token instead of generating one
# COMPANION_TOKEN_FILE=~/.ai-code-companion/token

# --- LLM ----------------------------------------------------------------
# With no key the app uses StubChatModel: same tool-calling and streaming path,
# no network. Set a key, or point it at an Ollama, to switch to a real model.
# LLM_PROVIDER=stub|openai|ollama
# OPENAI_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1      # any OpenAI-compatible gateway
# OLLAMA_BASE_URL=http://127.0.0.1:11434      # used by the model and the embedder
# Unset means the provider picks: gpt-4o-mini for openai, qwen2.5-coder:7b for
# ollama. An Ollama model has to support tools, or every turn answers from nothing.
# LLM_MODEL=
# LLM_TEMPERATURE=0
# Ceiling on one whole chat turn, tool calls included. Past it the turn is
# cancelled and POST /chat answers 504 instead of holding the connection open.
# LLM_TIMEOUT_MS=120000
# STUB_TOKEN_DELAY_MS=8                        # 0 makes the stub stream instantly

# --- Embeddings ---------------------------------------------------------
# `hashing` is deterministic and offline; `openai` needs a key; `ollama` is local
# and semantic. A name no plugin provides stops the app at startup rather than
# writing an index nothing can search.
# EMBEDDINGS_PROVIDER=hashing|openai|ollama
# Unset means the provider picks: text-embedding-3-small for openai,
# nomic-embed-text for ollama. EMBEDDINGS_DIMENSIONS is not sent to Ollama, whose
# models have a native width.
# EMBEDDINGS_MODEL=
# EMBEDDINGS_DIMENSIONS=384
# EMBEDDINGS_MODEL=text-embedding-3-small

# --- ChromaDB -----------------------------------------------------------
# Falls back to an in-memory store when the server is unreachable.
# CHROMA_ENABLED=true
# CHROMA_URL=http://localhost:8000
# CHROMA_COLLECTION=code-companion

# --- Indexing -----------------------------------------------------------
# Absolute directories the /index endpoint may read. Defaults to $HOME.
# INDEX_ALLOWED_ROOTS=/Users/you/projects,/Users/you/work
# CHUNK_SIZE=1200
# CHUNK_OVERLAP=200
# MAX_FILE_BYTES=524288
# Re-index a folder as its files change. Off by default: it holds one OS watch
# handle per indexed folder for as long as the app runs.
# INDEX_WATCH=true
# INDEX_WATCH_DEBOUNCE_MS=1500

# A fuse against a runaway local script, not a quota: POST /chat spends money
# against a real API key and POST /index walks a filesystem. Reads are never
# limited. Counted per route, per window.
# How many conversations the backend remembers before evicting the least
# recently used one. They live in memory: a reload keeps them, a restart does not.
# MAX_CONVERSATIONS=200

# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_CHAT=60
# RATE_LIMIT_INDEX=30
# INDEX_CONCURRENCY=8
# METADATA_DB=./.data/metadata.sqlite

# --- MCP ----------------------------------------------------------------
# When true the agent loads its tools from the MCP stdio server (requires a build)
# instead of calling them in-process.
# MCP_CLIENT_ENABLED=false
# MCP_SERVER_COMMAND=node
# MCP_SERVER_ARGS=./dist/mcp-server.js

# --- Logging ------------------------------------------------------------
# LOG_LEVEL=debug
