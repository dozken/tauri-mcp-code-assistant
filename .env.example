# Copy to backend/.env or export these before `npm run dev:backend`.
# Every value below is optional — the app runs fully offline with the defaults.

# --- HTTP ---------------------------------------------------------------
# Loopback by default: the backend reads local files and is not meant to be shared.
HOST=127.0.0.1
PORT=3001
CORS_ORIGINS=http://localhost:1420,http://127.0.0.1:1420,tauri://localhost,http://tauri.localhost

# --- LLM ----------------------------------------------------------------
# With no key the app uses StubChatModel: same tool-calling and streaming path,
# no network. Set a key to switch to a real model.
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1   # or any OpenAI-compatible gateway
# LLM_PROVIDER=stub|openai
# LLM_MODEL=gpt-4o-mini
# LLM_TEMPERATURE=0
# STUB_TOKEN_DELAY_MS=8                        # 0 makes the stub stream instantly

# --- Embeddings ---------------------------------------------------------
# `hashing` is deterministic and offline; `openai` requires OPENAI_API_KEY.
# EMBEDDINGS_PROVIDER=hashing|openai
# EMBEDDINGS_DIMENSIONS=384
# EMBEDDINGS_MODEL=text-embedding-3-small

# --- ChromaDB -----------------------------------------------------------
# Falls back to an in-memory store when the server is unreachable.
# CHROMA_ENABLED=true
# CHROMA_URL=http://localhost:8000
# CHROMA_COLLECTION=code-companion

# --- Indexing -----------------------------------------------------------
# Absolute directories the /index endpoint may read. Defaults to $HOME.
# INDEX_ALLOWED_ROOTS=/Users/you/projects,/Users/you/work
# CHUNK_SIZE=1200
# CHUNK_OVERLAP=200
# MAX_FILE_BYTES=524288
# INDEX_CONCURRENCY=8
# METADATA_DB=./.data/metadata.sqlite

# --- MCP ----------------------------------------------------------------
# When true the agent loads its tools from the MCP stdio server (requires a build)
# instead of calling them in-process.
# MCP_CLIENT_ENABLED=false
# MCP_SERVER_COMMAND=node
# MCP_SERVER_ARGS=./dist/mcp-server.js

# --- Logging ------------------------------------------------------------
# LOG_LEVEL=debug
