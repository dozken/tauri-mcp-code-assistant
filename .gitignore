# dependencies
node_modules/

# builds
dist/
app/dist/
backend/dist/
# The packaged sidecar: a 126 MB executable, rebuilt by `npm run package`.
backend/dist-bin/
app/src-tauri/target/
app/src-tauri/gen/

# local data & reports
backend/.data/
coverage/
reports/
.stryker-tmp/
playwright-report/
test-results/
blob-report/

# env & editor
.env
.env.local
*.tsbuildinfo
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# `tauri icon` writes a mobile asset set alongside the desktop one. This app has
# no mobile target, so committing thirty-odd files nothing builds would only make
# regenerating the icons look like a change.
app/src-tauri/icons/android/
app/src-tauri/icons/ios/
