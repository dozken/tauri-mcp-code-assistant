{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "packages/contracts": {
      // A library: its barrel is the public API, so an export that no consumer
      // happens to use today is a contract, not dead code.
      "includeEntryExports": false,
    },
    "backend": {
      "entry": [
        "src/**/*.spec.ts",
        "test/**/*.spec.ts",
        // The plugin-authoring surface. Its consumers are out-of-repo packages, so
        // "nothing here imports it" is what a working extension point looks like.
        "src/**/*.plugin.ts",
        // Build scripts: run by npm, imported by nothing.
        "scripts/**/*.mjs",
      ],
      // Referenced by stryker.config.json, which Knip does not read.
      "ignore": ["vitest.mutation.config.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts", "scripts/**/*.mjs", "*.config.ts"],
      // Loaded by pino as a worker target string, so no import exists to find.
      // `postject` is a CLI the packaging script runs by resolved path, for the
      // same reason: there is no import to see.
      "ignoreDependencies": ["pino-pretty", "postject"],
      // Same reasoning as the contracts barrel: a plugin file's exports are the
      // API an out-of-repo plugin compiles against, so "unused here" is expected.
      "includeEntryExports": false,
    },
    "app": {
      "entry": ["src/**/*.test.{ts,tsx}", "e2e/**/*.spec.ts"],
      "project": ["src/**/*.{ts,tsx}", "e2e/**/*.ts", "*.config.ts"],
    },
  },
  // Ships with the Rust toolchain, not with npm.
  "ignoreBinaries": ["rustfmt"],
  "includeEntryExports": true,
}
