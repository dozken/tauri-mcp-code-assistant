{
  "name": "ai-code-companion",
  "version": "0.1.0",
  "private": true,
  "description": "AI Code Companion — Tauri v2 + NestJS + MCP + LangChain + ChromaDB desktop app for chatting with your codebase.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "app",
    "backend"
  ],
  "scripts": {
    "dev": "npm run build --workspace @ai-code-companion/contracts && npm-run-all --parallel dev:contracts dev:backend dev:app",
    "dev:contracts": "npm run dev --workspace @ai-code-companion/contracts",
    "dev:backend": "npm run dev --workspace backend",
    "dev:app": "npm run dev --workspace app",
    "dev:tauri": "npm run build --workspace @ai-code-companion/contracts && npm run tauri:dev --workspace app",
    "build": "npm run build --workspaces --if-present",
    "mcp": "npm run mcp --workspace backend",
    "check": "npm-run-all --sequential format:check lint typecheck knip deps test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "knip": "knip",
    "deps": "depcruise app/src backend/src packages/contracts/src",
    "test": "npm run test --workspaces --if-present",
    "test:cov": "npm run test:cov --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspace app",
    "mutation": "npm-run-all --sequential mutation:backend mutation:app",
    "mutation:backend": "npm run mutation --workspace backend",
    "mutation:app": "npm run mutation --workspace app",
    "rust:fmt": "cargo fmt --manifest-path app/src-tauri/Cargo.toml --all -- --check",
    "rust:lint": "cargo clippy --manifest-path app/src-tauri/Cargo.toml --all-targets -- -D warnings",
    "clean": "npm run clean --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitest/eslint-plugin": "^1.6.27",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-playwright": "^2.11.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-unicorn": "^65.0.1",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "knip": "^6.34.0",
    "lint-staged": "^17.4.1",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.9.6",
    "typescript": "5.7.3",
    "typescript-eslint": "^8.69.0"
  }
}
